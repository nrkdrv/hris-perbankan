# Salin ke apps/api/.env lalu isi nilai rahasianya. Jangan commit file .env asli.
DATABASE_URL="postgresql://hris:hris@localhost:5432/hris_bank?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
WEB_URL="http://localhost:3000"

JWT_ACCESS_SECRET="ganti-dengan-rahasia-akses-min-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-rahasia-refresh-min-32-karakter"
WATERMARK_HMAC_SECRET="ganti-dengan-rahasia-hmac-min-32-karakter"

# local | s3  (local = simpan di ./storage; s3 = MinIO/S3-compatible)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-southeast-3"
S3_BUCKET="hris-bank"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Kosongkan untuk mode stub (log saja). Isi path JSON service account untuk push beneran.
FIREBASE_SERVICE_ACCOUNT_PATH=""
